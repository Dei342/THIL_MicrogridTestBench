                    component "core/C function" Output_Check {
                        arb_defs = "/*Begin code section*/
#define NumV (5)
#define NumF (7)
/*End code section*/"
                        global_variables = "real var_Fault_Zone;real var_CB;real var_GFL;"
                        init_fnc = "/*Begin code section*/
var_CB = 1;
var_GFL = 1;
var_Fault_Zone = -1;
/*End code section*/"
                        input_terminals = "int V_Trip;int V_Zone;int Reset;int F_Trip;int F_Zone;"
                        input_terminals_dimensions = "inherit;inherit;inherit;inherit;inherit"
                        input_terminals_feedthrough = "True;True;True;True;True"
                        input_terminals_show_labels = "True;True;True;True;True"
                        output_fnc = "/*Begin code section*/
CB = var_CB;
GFL = var_GFL;
Fault_Zone = var_Fault_Zone;
/*End code section*/"
                        output_terminals = "int Fault_Zone;int CB;int GFL;"
                        output_terminals_dimensions = "inherit;inherit;inherit"
                        output_terminals_feedthrough = "True;True;True"
                        output_terminals_show_labels = "True;True;True"
                        update_fnc = "/*Begin code section*/
//Inputs -> variables, necessary?
// var_V_Zone = V_Zone;
// var_F_Zone = F_Zone;

//Reset
if(Reset){
    var_CB = 1;
    var_GFL = 1;
    var_Fault_Zone = -1;
}
else{ //So check fault zone
    if(var_Fault_Zone == -1){ //No trips have occured yet
        //Volt Zone
        if(V_Trip){ // V fault
            var_Fault_Zone = V_Zone;
        }
        // Frequency Zone
        else if(F_Trip){ // F Fault
            var_Fault_Zone = F_Zone+NumV;
        }  
        
        if(var_Fault_Zone != -1){//Trip detected
            var_CB = 0;
            var_GFL = 0;
        }
    }
}
/*End code section*/"
