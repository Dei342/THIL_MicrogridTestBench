                        input_terminals_dimensions = "inherit"
                        input_terminals_feedthrough = "True"
                        input_terminals_show_labels = "True"
                        output_fnc = "/*Begin code section*/
Fault = Trip_Zone;

if (Trip_Zone > -1){
    Trip = 1;
}
else { Trip = 0;}



// for (int i = 0; i < OV_Num; i++ ){
//     debug[i] = ov_zones[i].timer*execution_rate;
// }
// for (int i = 0; i < UV_Num; i++){
//     debug[i+OV_Num] = uv_zones[i].timer*execution_rate;
// }

// o_debug = debug;

d0 = ov_zones[0].timer*execution_rate;
d1 = ov_zones[1].timer*execution_rate;
d2 = ov_zones[2].timer*execution_rate;
d3 = uv_zones[0].timer*execution_rate;
d4 = uv_zones[1].timer*execution_rate;
d5 = uv_zones[2].timer*execution_rate;
d6 = uv_zones[3].timer*execution_rate;
/*End code section*/"
                        output_terminals = "real Trip;inherit Fault;inherit d0;inherit d1;inherit d2;inherit d3;inherit d4;inherit d5;inherit d6;"
                        output_terminals_dimensions = "inherit;inherit;inherit;inherit;inherit;inherit;inherit;inherit;inherit"
                        output_terminals_feedthrough = "True;True;True;True;True;True;True;True;True"
                        output_terminals_show_labels = "True;True;True;True;True;True;True;True;True"
                        update_fnc = "/*Begin code section*/
//Initialise
Trip_Zone = -1;


//OF check, Zones 0, 1 and 2
for(int i = 0; i < OV_Num; i++)
{
    Violation = 0;
    
    if (Input > ov_zones[i].V_limit ){
        Violation = 1;
    }
    
    if (Violation){
        ov_zones[i].timer++;
        
        if ((ov_zones[i].timer*execution_rate) > ov_zones[i].t_limit){
            //debug = ov_zones[i].timer*execution_rate;
            Trip_Zone = i;
        }
    }
    else { ov_zones[i].timer = 0.0f;}
    
    
}

//UF Check, Zones 3, 4, 5 and 6 
for(int i = 0; i < UV_Num; i++)
{
    Violation = 0;
    
    if (Input < uv_zones[i].V_limit ){
        Violation = 1;
    }
    
    if (Violation){
        uv_zones[i].timer++;
        if ((uv_zones[i].timer*execution_rate) > uv_zones[i].t_limit){
            Trip_Zone = i + OV_Num;
        }
    }
    else { uv_zones[i].timer = 0.0f;}
}
/*End code section*/"
