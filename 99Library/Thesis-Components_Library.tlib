                component Subsystem PCC_Control_Old {
                    layout = dynamic
                    component "core/C function" Check_Limits {
                        arb_defs = "/*Begin code section*/

/*End code section*/"
                        execution_rate = "Ts_i"
                        global_variables = "real v_V;real v_f;real varCB;real varFault;real v_GFL;real v_Debug;"
                        init_fnc = "/*Begin code section*/
//initially trip is 0
varFault = 0;

//initially CB is closed
varCB = 1;


// BI switch command ( 1 -> stay in GFL ; 0 -> switch to GFM) Grid Forming vs Grid foLlowing
v_GFL = 1;

//initialise

v_V = 1;
v_f = 1;

v_Debug = 1;
/*End code section*/"
                        input_terminals = "real Vup;real Vlow;real Fup;real Flow;inherit V;inherit f;int Reset;"
                        input_terminals_dimensions = "inherit;inherit;inherit;inherit;inherit;inherit;inherit"
                        input_terminals_feedthrough = "True;True;True;True;True;True;True"
                        input_terminals_show_labels = "True;True;True;True;True;True;True"
                        output_fnc = "/*Begin code section*/
// Check if parameters within limits
// If not, set trip(output) to appropriate value (0,1,2,3,4)

//Limits
if(varCB == 1){ //CB closed, if open don\'t change Fault value
    if(v_V > Vup){ //OV
        varFault = 1;
    }
    else if(v_V < Vlow){ //UV
        varFault = 2;
    }
    
    else if(v_f > Fup){ //OF
        varFault = 3;
    }
    
    else if(v_f < Flow){ //UF
        varFault = 4;
    }
}    

// CB stays closed as long as there\'s no fault, GFL = true
if(varFault < 1){ //Fault = 0
    varCB = 1;
    v_GFL = 1;
}
else{ //Fault means open CB, send instruction to transition to GFM
    varCB = 0;
    v_GFL = 0;
}

//Update outputs
Fault = varFault;
CB = varCB;

GFL = v_GFL;

oDebug = v_Debug;
/*End code section*/"
                        output_terminals = "int Fault;int CB;real GFL;real oDebug;"
                        output_terminals_dimensions = "inherit;inherit;inherit;inherit"
                        output_terminals_feedthrough = "True;True;True;True"
                        output_terminals_show_labels = "True;True;True;True"
                        update_fnc = "/*Begin code section*/
v_V = V;
v_f = f;


if(Reset){
    varFault = 0;
    varCB = 1;
    v_GFL = 1;
}
/*End code section*/"
