                    component "Thesis_Stuff/Phase-Synch-Switching" Input-Synch-Switching_V {
                        arb_defs = "/*Begin code section*/
int sw_in, sw_out, sw_last;
float V_in, V_targ;
/*End code section*/"
                        init_fnc = "/*Begin code section*/
sw_in = 1;
sw_out = 1;
sw_last = 1;

V_in = 1;
V_targ = 1;
/*End code section*/"
                        input_terminals = "int in_sw;inherit in_FRT;inherit in_Trip;"
                        input_terminals_dimensions = "inherit;inherit;inherit"
                        input_terminals_feedthrough = "True;True;True"
                        input_terminals_show_labels = "True;True;True"
                        output_fnc = "/*Begin code section*/
out_sw = sw_out;
/*End code section*/"
                        output_terminals = "real out_sw;"
                        output_terminals_dimensions = "inherit"
                        output_terminals_feedthrough = "True"
                        output_terminals_show_labels = "True"
                        update_fnc = "/*Begin code section*/
//Update holders with inputs
sw_in = in_sw;
// ph_in = in_phase;
// ph_targ = in_target;

if(sw_in != sw_last){//Edge detected
    switch (sw_in){
    case 1: //Input
        V_in = 1;    
        break;
    case 2: //FRT
        V_in = in_FRT;    
        break;
    case 3: //Trip
        V_in = in_Trip;    
        break;    
    }    
 
    
    if( (V_in < (V_targ+0.001))&&(V_in > (V_targ-0.001)) ){
        //in bounds
        sw_out = sw_in;     //update output
        sw_last = sw_in;    //update edge memory
    } // else not in bounds
} // else no edge
/*End code section*/"
                    }
