    CODE model_init
        # Numpy module is imported as 'np'
        # Scipy module is imported as 'sp'
        # The Schematic API is imported as 'mdl'
        # To get the model file path, use 'mdl.get_model_file_path()'
        # To print information to the console, use info()
        
        Ts_i = 1e-6
        
        #--------------------Grid--------------------------
        Vg_LL = 400    #V--------------------------VLL
        Vg_LN = Vg_LL/np.sqrt(3)
        fgrid = 50      #Hz-------------------------f
        wg = 2* np.pi * fgrid
        
        #--------------- Calculate Rg and Lg -----------------
        
        #Need Sess for calculations
        Sess = 100e3    #VA------------------------Sinv
        
        SCR = 50 #--------------------------------SCR
        XR_ratio = 5 #---------------------------X/R
        
        #-------Calculate Zg = Rg + jXg------------
        S_sc = Sess* SCR
        Zg = (Vg_LL*Vg_LL)/(S_sc)
        
        Rg = (Zg)/(np.sqrt(1+XR_ratio*XR_ratio))
        Xg = XR_ratio*Rg
        Lg = Xg/wg
        
        #--------------------------------------------------
        
        #--------------Manual entry-----------------------------
        #Lg = 0.07201e-3     #H
        #Rg = 0.02262    #Ohm
        
        
        
        #-----------------------ESS-------------------------------
        Vess = Vg_LL      #V
        # Sess declared above
        cosphiess = 0.99
        Pess = Sess*cosphiess
        
        #-------------Inverter-----------------------------
        fsw = 2.5e3      #Hz
        
        #Controller Gains
        
        
        #Current control
        #Default: Kp = 0.347 Ki = 347.22    iDamp = -0.272
        
        dKp = 0.347     #----------------------------Kp
        qKp = dKp
        dKi = 347.22    #----------------------------Ki
        qKi = dKi
        iDamp = -0.272  #----------------------------iDamp
        
        
        #IDM
        #SFS
        k_SFS = 0.32 #0.1 - 85ms
        feLimit_O = 0.05
        feLimit_U = -0.07
        dwtLimit = 1.05
        
        
        #Voltage control
        #Default: Kp = 10 Ki = 10
        v_ref_Kp = 10 
        v_ref_Ki = 10
        
        
        #--------------------------------Filter------------------------------
        # Default Lf= 0.1e-3
        Lf = 1.33e-3    #Inductor [H]----------------Lf
        
        #Default ESR_L = 1e-5
        ESR_L = 1.1104e-4    #ESR Inductor [Ohm]
        
        #Default f_c= 500
        f_c = 500       #Filter cutof frequency
        
        #Default ESR_C= 15e-3
        ESR_C = 0.1667   #ESR Capacitor [Ohm]
        
        #Vdc
        Vdc = 850 #V--------------------------------Vdc
        # Bat Cap should change with Sess and Vess!
        BatCap = (Sess/Vdc)*10 #Up to 10 Hours at maximum capacity
        #Massive
        
        #---------------------------------------------------
        
        
        
        #------------------Set Load parameters-----------------------
        RL = 1.603     #2.667 for 1.6MVA, 1.603 for 100kVA,
        LL = 10.21e-3   #3.581e-3
        CL = 993.3e-6   #4421e-6
        
        #enter P, Ql and Qc of load
        P_load = 0.7 #pu
        Q_l = 0.7     #pu
        Q_c = 0.7   #pu
        
        # Load value calculations
        P_load = P_load * Pess  #W
        Q_l =  Q_l * Pess       #VAr
        Q_c = Q_c * Pess        #VAr
        
        RL = (Vess**2)/P_load   #Ohm
        LL = (Vess**2)/(wg*Q_l)   #H 
        CL = Q_c/(wg*(Vess**2))   #F
        #-----------------------------------------------------------
        
        
        
        #----------------------Variable load -------------------------
        #internal
        LRs = 10e-6  #H, inductor in series with R : small as possible
        
        RLp = 100e3  #Ohm, L shunt resistor, large as possible
        RLs = 16e-3 #Ohm, R in series with L
        
        RCs = 16e-3   #Ohm, C damping resistor
        
        # To per unit
        Rbase = 1.6
        Lbase = 5.093e-3
        Cbase = 1989.44e-6
        #---------------------------------------------------------
    ENDCODE
}
