                    component "core/C function" Inv_Cab_SM {
                        arb_defs = "/*Begin code section*/

/*End code section*/"
                        global_variables = "real lock1;real lock2;real from_grid_follow;real control_mode_state;uint Vmode_state;uint synch_state;uint contactor_state;"
                        init_fnc = "/*Begin code section*/
lock1 = 0;
lock2 = 0;
from_grid_follow = 0;
control_mode_state = 0;
Vmode_state = 0;
synch_state = 0;
contactor_state = 0;
/*End code section*/"
                        input_terminals = "inherit On;inherit mode;inherit grid_locked;inherit v_match;inherit live_grid;inherit on_nominal;"
                        input_terminals_dimensions = "inherit;inherit;inherit;inherit;inherit;inherit"
                        input_terminals_feedthrough = "True;True;True;True;True;True"
                        input_terminals_show_labels = "False;False;False;False;False;False"
                        output_fnc = "/*Begin code section*/
if(On == 0){ //all off
    contactor = 0;
    synch = 0;
    Vmode = 1;
    lock1 = 0;
    lock2 = 0;
    control_mode = 0;
    from_grid_follow = 0;
}
else{
    if((mode == 0) && (lock1 == 0)){ //voltage mode
        lock2 = 0;
        if((on_nominal) || (from_grid_follow)){
            Vmode = 1;
            contactor = 1;
            synch = 0;
            lock1 = 1;
            control_mode = 1;
            from_grid_follow = 0;
        }
        else{
            Vmode = 1;
            contactor = 0;
            synch = 0;
            control_mode = 0;
        }
    }
    else{
        if((mode == 1) && (lock2 ==0)){ //current mode
            lock1 = 0;
            if((on_nominal) && (live_grid == 1)){
                synch = 1;
                if((grid_locked == 1) && (v_match == 1)){
                    Vmode = 0;
                    contactor = 1;
                    synch = 0;
                    lock2 = 1;
                    control_mode = 2;
                    from_grid_follow = 1;
                }
                else{
                    Vmode = 1;
                    contactor = 0;
                    control_mode = 0;
                }
            }
            else{
                Vmode = 1;
                contactor = 0;
                synch = 0;
                control_mode = 0;
            }
        }
        else {
            Vmode = Vmode_state;
            contactor = contactor_state;
            synch = synch_state;
            control_mode = control_mode_state;
            // anti-islanding (added on 13 May 2025)
            //if((mode == 1) && (live_grid == 0)){ // Need to island
            //    contactor = 0;
            //}
        }
    }
}
/*End code section*/"
                        output_terminals = "real control_mode;inherit Vmode;inherit synch;inherit contactor;"
                        output_terminals_dimensions = "inherit;inherit;inherit;inherit"
                        output_terminals_feedthrough = "True;True;True;True"
                        output_terminals_show_labels = "False;False;False;False"
                        update_fnc = "/*Begin code section*/
Vmode_state = Vmode;
contactor_state = contactor;
synch_state = synch;
control_mode_state = control_mode;
/*End code section*/"
                    }
