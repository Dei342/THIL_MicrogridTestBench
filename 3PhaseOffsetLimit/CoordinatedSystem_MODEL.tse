                        type = generic
                        default_value = "100e-6"
                        unit = "s"
                        group = "General"
                        context typhoonsim {
                        }

                        context real_time {
                        }

                    }

                    enable_probes {
                        label = "Enable internal probes"
                        widget = checkbox
                        type = bool
                        default_value = "True"
                        group = "General"
                        no_evaluate
                        context typhoonsim {
                        }

                        context real_time {
                        }


                        CODE property_value_changed
                            t_ph_m = return_t_ph_m(mdl)
                            t_ph_m.enable_internal_probes(mdl, container_handle, new_value)
                        ENDCODE
                    }

