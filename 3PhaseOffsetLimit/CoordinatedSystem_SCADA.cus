<ui_settings>
    <version>2.8</version>
    <model_locked>True</model_locked>
    <canvas_bg_color>#ffffff</canvas_bg_color>
    <initialization_code><![CDATA[# NOTE: Variables and functions defined here will be
# available for use in all Macro and Expression scripts.
# NOTE: This code is always executed prior to simulation start.

# The variable 'SETTINGS_DIR' holds the directory where the loaded Panel .cus file is located.
# Also you can call the 'get_settings_dir_path()' function in any
# Macro and Expression script to get the same directory.
SETTINGS_DIR = get_settings_dir_path()

# The 'add_to_python_path(folder)' function can be used to add a custom folder
# with Python files and packages to the PYTHONPATH. After a folder is added, all Python
# files and Python packages from it can be imported into the SCADA Namespace.

# HIL API is imported as 'hil'
# SCADA API is imported as 'panel'
# SCADA API constants are imported as 'api_const'
# Numpy module is imported as 'np'
# Scipy module is imported as 'sp'
# Schematic Editor model namespace is imported as 'scm'
# Function for printing to the HIL SCADA Message log is imported as 'printf'.


#Global variables
global Rload
global Lload
global Cload
Rbase = 1.6 
Lbase = 5.093
Cbase = 1989.44

#For Calculator
global V_c
global f_c
global P_c
global R_c
global L_c
global C_c
global P_c
global Ql_c
global Qc_c

#Widget stuff
global WHC_R
global WHC_L
global WHC_C
WHC_R = panel.get_widget_by_id("922f31231d2811f197cf989096b8b3de")
WHC_L = panel.get_widget_by_id("922f31251d2811f1b2da989096b8b3de")
WHC_C = panel.get_widget_by_id("922f31241d2811f1a8eb989096b8b3de")

global WH_R
global WH_L
global WH_C
WH_R = panel.get_widget_by_id("ec237aa176af11f0b32d989096b8b3de")
WH_L = panel.get_widget_by_id("0179091276b011f0af26989096b8b3de")
WH_C = panel.get_widget_by_id("0370069276b011f0a5a0989096b8b3de")


#Functions
#Update Text Box values
def Update_TB_R(Rt):
    Rt = round(Rt*Rbase, 3)
    panel.set_property_value(WH_R, api_const.PROP_TEXT, str(Rt))

def Update_TB_L(Lt):
    Lt = round(Lt*Lbase,3)
    panel.set_property_value(WH_L, api_const.PROP_TEXT, str(Lt))

def Update_TB_C(Ct):
    Ct = round(Ct*Cbase,3)
    panel.set_property_value(WH_C, api_const.PROP_TEXT, str(Ct))
    
    
def Update_R(Rl):
    hil.set_scada_input_value('Ra-In', Rl)
    hil.set_scada_input_value('Rb-In', Rl)
    hil.set_scada_input_value('Rc-In', Rl)
    Update_TB_R(Rload)
    
def Update_L(Ll):
    hil.set_scada_input_value('La-In', Ll)
    hil.set_scada_input_value('Lb-In', Ll)
    hil.set_scada_input_value('Lc-In', Ll)
    Update_TB_L(Lload)
    
def Update_C(Cl):
    hil.set_scada_input_value('Ca-In', Cl)
    hil.set_scada_input_value('Cb-In', Cl)
    hil.set_scada_input_value('Cc-In', Cl)
    Update_TB_C(Cload)

#Update Calculation Text Box values
def Update_TBC_R(Rt):
    Rt = round(Rt, 3)
    panel.set_property_value(WHC_R, api_const.PROP_TEXT, str(Rt))

def Update_TBC_L(Lt):
    Lt = round(Lt*1e3,3)
    panel.set_property_value(WHC_L, api_const.PROP_TEXT, str(Lt))

def Update_TBC_C(Ct):
    Ct = round(Ct*1e6,3)
    panel.set_property_value(WHC_C, api_const.PROP_TEXT, str(Ct))
    




#Initialise Values
    #Load
Rload = 1       #pu
Lload = 1       #pu
Cload = 1       #pu

Update_R(Rload)
Update_L(Lload)
Update_C(Cload)


    #ESS
        #Alarm Limits (in p.u.)
#hil.model_write('ESS_UI_IDM.V alarm upper limit', 10)
#hil.model_write('ESS_UI_IDM.V alarm lower limit', 0)
#hil.model_write('ESS_UI_IDM.F alarm upper limit', 10)
#hil.model_write('ESS_UI_IDM.F alarm lower limit', 0)
#hil.model_write('ESS_UI_IDM.I alarm upper limit', 10)
#hil.model_write('ESS_UI_IDM.S alarm upper limit', 10)


    #Calculator
V_c = 230
f_c = 50
P_c = 99000
Ql_c = 99000
Qc_c = 99000
R_c = Rload*Rbase
L_c = Lload*Lbase*1e-3
C_c = Cload*Cbase*1e-6


#Initialise Widgets
Update_TB_R(Rload)
Update_TB_L(Lload)
Update_TB_C(Cload)

Update_TBC_R(R_c)
Update_TBC_L(L_c)
Update_TBC_C(C_c)
]]></initialization_code>
